# Reference only: settings.py does not automatically load .env.
# Set private local values in your process environment, never commit them.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
JWT_SIGNING_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://127.0.0.1:5501
DJANGO_DB_PATH=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# No delivery and no recovery-link output for local tests.
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
DEFAULT_FROM_EMAIL=noreply@localhost
PASSWORD_RESET_URL=http://127.0.0.1:5501/screen/find-account.html
# Production requires DEBUG=0, explicit private keys/hosts and SMTP backend.
